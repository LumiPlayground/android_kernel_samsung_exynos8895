config FMP_UFS
	tristate "Samsung EXYNOS FMP Driver for UFS"
	depends on SCSI_UFSHCD && SCSI_UFSHCD_PLATFORM
	depends on UFS_FMP_DM_CRYPT || UFS_FMP_EXT4CRYPT_FS
	---help---
	  This is EXYNOS FMP UFS driver.

	  It is enabled automatically when any UFS FMP feature is enabled.

config FMP_MMC
	tristate "Samsung EXYNOS FMP Driver for MMC"
	depends on MMC_DW
	depends on MMC_DW_FMP_DM_CRYPT || MMC_DW_FMP_EXT4CRYPT_FS
	---help---
	  This is EXYNOS FMP MMC driver.

	  It is enabled automatically when any MMC FMP feature is enabled.

config FMP_DM_CRYPT
	tristate "Samsung EXYNOS FMP DM_CRYPT Driver"
        depends on DM_CRYPT
	depends on UFS_FMP_DM_CRYPT || MMC_DW_FMP_DM_CRYPT
	---help---
	  This is EXYNOS FMP DM_CRYPT driver.

	  It is enabled automatically when any FMP DM_CRYPT feature is enabled.

config FMP_EXT4CRYPT_FS
	tristate "Samsung EXYNOS FMP Ext4Crypt FS ENcryption Driver"
        depends on EXT4_FS_ENCRYPTION
	depends on UFS_FMP_EXT4CRYPT_FS || MMC_DW_FMP_EXT4CRYPT_FS
	---help---
	  This is EXYNOS FMP Ext4Crypt FS ENCRYPTION driver.

	  It is enabled automatically when any Ext4Crypt FMP FS feature is enabled.

config FIPS_FMP
	tristate "Samsung EXYNOS FMP Validation Driver for FIPS"
	depends on FMP_UFS
	depends on !FUNCTION_TRACER
	---help---
	  This selects Samsung EXYNOS FMP Validation driver for FIPS.

	  If you have a controller with this interface, say Y here.

	  If unsure, say N.
